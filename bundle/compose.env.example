# Copy to .env next to docker-compose.yml and edit. Keep this file readable by the service account only
# (chmod 600 .env): it holds the restore database password.

# Application image loaded from the bundle (docker load -i images/tripline-scope-<version>.tar)
TSCOPE_IMAGE=tripline-scope:0.1.0

# PostgreSQL 16 for local restores of PostgreSQL dumps
TSCOPE_POSTGRES_IMAGE=mirror.gcr.io/library/postgres:16
TSCOPE_PG_USER=tripline
TSCOPE_PG_PASSWORD=change-me-to-a-long-random-value
TSCOPE_PG_DB=restores
TSCOPE_PG_BIND=127.0.0.1
TSCOPE_PG_PORT=5432
TSCOPE_RESTORE_INBOX=./restore-inbox

# Host directories mounted into the application container
TSCOPE_CASES_DIR=./cases
TSCOPE_SOURCES_DIR=./sources
TSCOPE_KEK_DIR=./kek

# Air-gapped operation: no route off the host for any container (host port publishing is disabled too)
TSCOPE_NETWORK_INTERNAL=false

# SQL Server Developer Edition: synthetic demos and tests ONLY (docker compose --profile demo ...).
# Real cases restore .bak files to a SQL Server the hospital provides and licenses.
TSCOPE_MSSQL_ACCEPT_EULA=N
TSCOPE_MSSQL_SA_PASSWORD=
TSCOPE_MSSQL_BIND=127.0.0.1
TSCOPE_MSSQL_PORT=1433
TSCOPE_DEMO_BAK_DIR=./demo-bak
